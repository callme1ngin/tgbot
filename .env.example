BOT_TOKEN=your_telegram_bot_token_here
NODE_ENV=production
PORT=3000

BROWSER_CONTEXTS=2
PAGES_PER_CONTEXT=3
MAX_CONCURRENT_REQUESTS=4

SCREENSHOT_WIDTH=1920
SCREENSHOT_HEIGHT=1080
FRIEND_SCREENSHOT_WIDTH=1280
FRIEND_SCREENSHOT_HEIGHT=720

HTTP_TIMEOUT_MS=10000
MAX_REDIRECTS=3
FETCH_RETRIES=2
FETCH_RETRY_DELAY_MS=500
IMAGE_LOAD_TIMEOUT_MS=5000
IMAGE_RETRY_COUNT=1
CACHE_SIZE=100
CACHE_TTL_MS=3600000

# Tracker: presence of the Steam profiles a user follows.
# Key from https://steamcommunity.com/dev/apikey — without it the tracker stays off.
STEAM_WEB_API_KEY=
TRACKER_POLL_MS=10000
TRACKER_MAX_PER_USER=10
TRACKER_MAX_TOTAL=500

# Captcha at the door: a simple sum, three answers, one right.
# Two wrong answers → pause. Bypass ids — who skips it (comma separated user ids).
CAPTCHA_MAX_WRONG=2
CAPTCHA_COOLDOWN_MS=180000
CAPTCHA_BYPASS_IDS=

# Access: roles and subscriptions. ADMIN_IDS — the first admin (comma separated telegram ids):
# it is the only way into the admin panel before any promo code exists. Without it nobody is admin.
ADMIN_IDS=
ACCESS_DATA_DIR=./data
PROMO_MAX_USES=1
PROMO_CODE_MAX=20
