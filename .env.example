BOT_TOKEN=your_telegram_bot_token_here
NODE_ENV=production
PORT=3000

BROWSER_CONTEXTS=2
PAGES_PER_CONTEXT=3
MAX_CONCURRENT_REQUESTS=4

SCREENSHOT_WIDTH=1920
SCREENSHOT_HEIGHT=1080
FRIEND_SCREENSHOT_WIDTH=1280
FRIEND_SCREENSHOT_HEIGHT=720

HTTP_TIMEOUT_MS=10000
MAX_REDIRECTS=3
FETCH_RETRIES=2
FETCH_RETRY_DELAY_MS=500
IMAGE_LOAD_TIMEOUT_MS=5000
IMAGE_RETRY_COUNT=1
CACHE_SIZE=100
CACHE_TTL_MS=3600000

# Tracker: presence of the Steam profiles a user follows.
# Key from https://steamcommunity.com/dev/apikey — without it the tracker stays off.
STEAM_WEB_API_KEY=
TRACKER_POLL_MS=60000
TRACKER_MAX_PER_USER=10
TRACKER_MAX_TOTAL=500
